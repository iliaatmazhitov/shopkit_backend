{
  "app": {
    "threads_num": 0,
    "idle_connection_timeout": 120,
    "server_header_field": "",
    "enable_session": false,
    "session_timeout": 0,
    "document_root": "./public",
    "upload_path": "./uploads",
    "file_types": ["gif", "png", "jpg", "jpeg", "webp"],
    "max_connections": 100000,
    "max_connections_per_ip": 0,
    "load_config_file": true,
    "run_as_daemon": false,
    "relaunch_on_error": false,
    "use_sendfile": true,
    "use_gzip": true,
    "use_brotli": true,
    "static_files_cache_time": 31536000,
    "simple_controllers_map_size": 2000,
    "enable_server_header": false,
    "enable_date_header": true,
    "keepalive_requests": 0,
    "pipelining_requests": 0,
    "client_max_body_size": "10M",
    "client_max_memory_body_size": "64K",
    "client_max_websocket_message_size": "128K"
  },
  "db_clients": [
    {
      "name": "default",
      "rdbms": "postgresql",
      "host": "${DATABASE_HOST}",
      "port": 5432,
      "dbname": "${DATABASE_NAME}",
      "user": "${DATABASE_USER}",
      "passwd": "${DATABASE_PASSWORD}",
      "connection_number": 10,
      "is_fast": true,
      "timeout": 30.0,
      "client_encoding": "utf8",
      "auto_batch": true
    }
  ],
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 8080,
      "https": false
    }
  ],
  "log": {
    "log_path": "./logs",
    "logfile_base_name": "shopkit",
    "log_size_limit": 100000000,
    "log_level": "INFO"
  },
  "cors": {
    "allow_all": true
  }
}

