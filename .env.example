# ShopKit Backend Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/shopkit
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shopkit
DATABASE_USER=your_user
DATABASE_PASSWORD=your_password

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Environment
NODE_ENV=production
ENVIRONMENT=production

# Logging
LOG_LEVEL=INFO

# Security (optional)
# CORS_ORIGINS=https://yoursite.com,https://t.me
# MAX_REQUEST_SIZE=10M

# Optional Features
# UPLOAD_PATH=./uploads
# ENABLE_IMAGE_UPLOAD=true

# Production URLs (examples)
# API_URL=https://shopkit-backend.onrender.com/api
# FRONTEND_URL=https://t.me/your_bot/shop
